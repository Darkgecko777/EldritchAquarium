[node name="Pet" type="CharacterBody2D"]
script = ExtResource("1_pet")

; Visual now uses the Goldfish_Stage_One_Idle sprite sequence (53 frames in assets/sprites/pets/starter/) for animation.
; The script (in _ready) creates an AnimatedSprite2D named "Sprite", loads the frames, centers via offset (-size/2), scales to ~100px, adds alignment shift to offset (120, -120 in final px, converted to texture space via /sf) so the fish art (not frame) is centered on pet origin (0,0) which is the collision center (InteractArea radius 60) and logical position.
; Bob sets position to (0, bob). Hunger bar positioned in update relative to _body.position + scaled height.
; This aligns visual, collision debug, and hunger bar. Replaces previous primitives.
; Evolution stages can later use different sprite sets or overlay effects. Hunger bar and hold tints (modulate) managed in script.

[node name="InteractArea" type="Area2D" parent="."]

[node name="CollisionShape2D" type="CollisionShape2D" parent="InteractArea"]
shape = SubResource("CircleShape2D_1")
