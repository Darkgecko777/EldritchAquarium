; === HUNGER BAR (editor-placed holders; script positions, sizes, and colors the fill) ===
; Prefer editor nodes over runtime creation for primary entity visuals and affordances.
; Serialized using the exact style that works for other manually-positioned ColorRects
; directly under Node2D/CharacterBody2D in this project (see Aquarium backgrounds).
; The child uses layout_mode=0 so Godot knows its rect is manually defined relative to
; its ColorRect parent (prevents parse errors when opening the .tscn in the editor).
[node name="HungerBarBG" type="ColorRect" parent="."]
offset_left = -34.0
offset_top = 30.0
offset_right = 36.0
offset_bottom = 36.0
color = Color(0.10, 0.07, 0.05, 0.95)
mouse_filter = 2

[node name="HungerBarFill" type="ColorRect" parent="HungerBarBG"]
layout_mode = 0
offset_left = 1.0
offset_top = 1.0
offset_right = 69.0
offset_bottom = 5.0
color = Color(0.92, 0.62, 0.25)
mouse_filter = 2
